# ============================================
# AUTO.RIA SCRAPER CONFIGURATION
# ============================================

# ========= DATABASE =========
# PostgreSQL connection string
DATABASE_URL=postgresql://autoria_user:autoria_pass@localhost:5433/autoria_db

# ========= SCHEDULER =========
# Daily scraping time (24h format)
SCRAPER_START_TIME=12:00

# Daily database dump time (should be after scraping)
DUMP_TIME=12:05

# ========= SCRAPER SETTINGS =========
# Start URL for scraping
START_URL=https://auto.ria.com/uk/car/used/

# Maximum concurrent HTTP requests
MAX_CONCURRENT_REQUESTS=5

# Delay between requests in seconds
REQUEST_DELAY=1.5

# Maximum pages to scrape (for testing)
MAX_PAGES_TO_SCRAPE=10

# Maximum ads to scrape per run (0 = unlimited)
MAX_ADS_TO_SCRAPE=200

# ========= ANTI-BAN SETTINGS =========
# Rotate User-Agent headers
USER_AGENT_ROTATION=true

# Use proxy servers (true/false)
USE_PROXY=false

# Proxy list (if USE_PROXY=true)
# PROXY_LIST=http://proxy1:port,http://proxy2:port

# Retry failed requests
MAX_RETRIES=3
RETRY_DELAY=2

# ========= DATABASE DUMP =========
# Number of days to keep old dumps
KEEP_DUMPS_DAYS=7

# Dump format (sql, custom, tar)
DUMP_FORMAT=sql

# ========= APPLICATION =========
# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Application environment (development, production)
ENVIRONMENT=development

# Enable debug mode
DEBUG=false
